
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char text[100], key[100];
    int i, j = 0;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter key: ");
    scanf("%99s", key);

    printf("Ciphertext: ");
    for (i = 0; text[i] != '\0'; i++) {
        if (isalpha(text[i])) {
            char p = toupper(text[i]) - 'A';
            char k = toupper(key[j % strlen(key)]) - 'A';
            printf("%c", (p + k) % 26 + 'A');
            j++;
        } else {
            printf("%c", text[i]);
        }
    }

    printf("\n");
    return 0;
}
