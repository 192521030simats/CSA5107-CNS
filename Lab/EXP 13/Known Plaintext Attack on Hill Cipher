
#include <stdio.h>

int main() {
    int p[2][2], c[2][2], k[2][2];
    int a, b, det, inv = -1, i, j;

    printf("Enter plaintext matrix (2x2):\n");
    for(i=0;i<2;i++)
        for(j=0;j<2;j++)
            scanf("%d",&p[i][j]);

    printf("Enter ciphertext matrix (2x2):\n");
    for(i=0;i<2;i++)
        for(j=0;j<2;j++)
            scanf("%d",&c[i][j]);

    det = (p[0][0]*p[1][1] -
           p[0][1]*p[1][0]) % 26;
    if(det<0) det+=26;

    for(i=1;i<26;i++)
        if((det*i)%26==1) inv=i;

    if(inv==-1) {
        printf("Cannot recover key: matrix has no inverse.\n");
        return 0;
    }

    a=p[1][1]; b=-p[0][1];
    p[1][1]=p[0][0]; p[0][0]=a;
    p[0][1]=b; p[1][0]=-p[1][0];

    for(i=0;i<2;i++)
        for(j=0;j<2;j++) {
            p[i][j]=(p[i][j]*inv)%26;
            if(p[i][j]<0) p[i][j]+=26;
        }

    printf("Recovered key matrix:\n");
    for(i=0;i<2;i++) {
        for(j=0;j<2;j++) {
            k[i][j]=0;
            for(a=0;a<2;a++)
                k[i][j]+=c[i][a]*p[a][j];
            k[i][j]%=26;
            printf("%d ",k[i][j]);
        }
        printf("\n");
    }

    return 0;
}
