
#include <stdio.h>
#include <string.h>

int gcd(int a, int b)
{
    return b == 0 ? a : gcd(b, a % b);
}

int main()
{
    char p[100];
    int a, b, i, c;

    printf("Enter plaintext: ");
    scanf("%99s", p);

    printf("Enter a and b: ");
    scanf("%d%d", &a, &b);

    if(gcd(a, 26) != 1)
    {
        printf("Invalid key! Encryption is not one-to-one.");
        return 0;
    }

    for(i = 0; p[i] != '\0'; i++)
    {
        c = (a * (p[i] - 'A') + b) % 26;
        printf("%c", c + 'A');
    }

    return 0;
}
