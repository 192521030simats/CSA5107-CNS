
#include <stdio.h>

int main()
{
    int q=23, a=5;
    int x=6, y=15;
    int A=1, B=1, K1=1, K2=1, i;

    for(i=0;i<x;i++)
        A=(A*a)%q;

    for(i=0;i<y;i++)
        B=(B*a)%q;

    for(i=0;i<x;i++)
        K1=(K1*B)%q;

    for(i=0;i<y;i++)
        K2=(K2*A)%q;

    printf("Alice Public Key: %d\n",A);
    printf("Bob Public Key: %d\n",B);
    printf("Alice Shared Key: %d\n",K1);
    printf("Bob Shared Key: %d\n",K2);

    return 0;
}
