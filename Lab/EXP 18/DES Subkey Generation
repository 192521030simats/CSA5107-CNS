
#include <stdio.h>

int main() {
    int shift[16] = {
        1,1,2,2,2,2,2,2,
        1,2,2,2,2,2,2,1
    };
    int C[28], D[28], i, r, s, temp;

    printf("Enter 28 bits of C:\n");
    for(i=0;i<28;i++) scanf("%d",&C[i]);

    printf("Enter 28 bits of D:\n");
    for(i=0;i<28;i++) scanf("%d",&D[i]);

    for(r=0;r<16;r++) {
        for(s=0;s<shift[r];s++) {
            temp=C[0];
            for(i=0;i<27;i++) C[i]=C[i+1];
            C[27]=temp;

            temp=D[0];
            for(i=0;i<27;i++) D[i]=D[i+1];
            D[27]=temp;
        }

        printf("Round %d: ",r+1);

        for(i=0;i<24;i++) printf("%d",C[i]);
        for(i=0;i<24;i++) printf("%d",D[i]);

        printf("\n");
    }
    return 0;
}
