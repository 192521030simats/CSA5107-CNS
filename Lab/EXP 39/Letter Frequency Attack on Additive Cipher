
#include <stdio.h>
#include <string.h>

int main()
{
    char text[500];
    int i, k, n;

    printf("Enter ciphertext: ");
    fgets(text, sizeof(text), stdin);

    printf("\nTop 10 Possible Plaintexts:\n");

    for(k = 0; k < 10; k++)
    {
        printf("\nKey %d: ", k);

        for(i = 0; text[i] != '\0'; i++)
        {
            if(text[i] >= 'A' && text[i] <= 'Z')
            {
                n = (text[i] - 'A' - k + 26) % 26;
                printf("%c", n + 'A');
            }
            else if(text[i] >= 'a' && text[i] <= 'z')
            {
                n = (text[i] - 'a' - k + 26) % 26;
                printf("%c", n + 'a');
            }
            else
                printf("%c", text[i]);
        }
    }

    return 0;
}
