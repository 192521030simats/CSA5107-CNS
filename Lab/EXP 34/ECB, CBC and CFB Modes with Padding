
#include <stdio.h>
#include <string.h>

int main()
{
    char text[100];
    int i, n;

    printf("Enter plaintext: ");
    scanf("%99s", text);

    n = strlen(text);

    // Padding: append 1 followed by zeros
    text[n++] = '1';
    while(n % 8 != 0)
        text[n++] = '0';

    text[n] = '\0';

    printf("\nPadded Text: %s", text);

    printf("\n\nECB Mode: ");
    for(i = 0; i < n; i++)
        printf("%c", text[i] ^ 1);

    printf("\nCBC Mode: ");
    for(i = 0; i < n; i++)
        printf("%c", text[i] ^ 2);

    printf("\nCFB Mode: ");
    for(i = 0; i < n; i++)
        printf("%c", text[i] ^ 3);

    return 0;
}
