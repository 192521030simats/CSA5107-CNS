
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char c[] = "KXJEYUREBEZWEHEWRYTUHEYFSKREHEGOYFI"
               "WTTTUOLKSYCAJPOBOTEIZONTXBYBNTGONEY"
               "CUZWRGDSONSXBOUYWRHEBAAHYUSEDQ";
    char key[30], m[5][5];
    int i, j, k, r1, c1, r2, c2, p = 0;
    char used[26] = {0};

    printf("Enter keyword: ");
    scanf("%29s", key);

    for (i = 0; key[i]; i++) {
        char ch = toupper(key[i]);
        if (ch == 'J') ch = 'I';
        if (ch >= 'A' && ch <= 'Z' && !used[ch-'A']) {
            m[p/5][p%5] = ch;
            used[ch-'A'] = 1;
            p++;
        }
    }

    for (i = 0; i < 26; i++) {
        if (i == 9) continue;
        if (!used[i]) {
            m[p/5][p%5] = 'A' + i;
            p++;
        }
    }

    printf("Decrypted text: ");
    for (i = 0; c[i] && c[i+1]; i += 2) {
        for (j = 0; j < 5; j++)
            for (k = 0; k < 5; k++) {
                if (m[j][k] == c[i]) r1=j, c1=k;
                if (m[j][k] == c[i+1]) r2=j, c2=k;
            }

        if (r1 == r2) {
            printf("%c%c", m[r1][(c1+4)%5],
                          m[r2][(c2+4)%5]);
        } else if (c1 == c2) {
            printf("%c%c", m[(r1+4)%5][c1],
                          m[(r2+4)%5][c2]);
        } else {
            printf("%c%c", m[r1][c2], m[r2][c1]);
        }
    }

    printf("\n");
    return 0;
}
