
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int gcd(int a, int b) {
    while (b != 0) {
        int t = b;
        b = a % b;
        a = t;
    }
    return a;
}

int main() {
    char text[100];
    int a, b, i, p, c;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter a and b: ");
    scanf("%d%d", &a, &b);

    if (gcd(a, 26) != 1) {
        printf("Invalid key: a must be coprime to 26.\n");
        return 0;
    }

    printf("Ciphertext: ");
    for (i = 0; text[i] != '\0'; i++) {
        if (isalpha(text[i])) {
            p = toupper(text[i]) - 'A';
            c = (a * p + b) % 26;
            printf("%c", c + 'A');
        } else {
            printf("%c", text[i]);
        }
    }

    return 0;
}
