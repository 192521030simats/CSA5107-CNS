
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char cipher[200];
    int a, b, i, c, p, inv;

    printf("Enter ciphertext: ");
    fgets(cipher, sizeof(cipher), stdin);

    /* Frequency assumptions: E -> B, T -> U */
    for (a = 1; a < 26; a++) {
        int found = 0;

        for (i = 1; i < 26; i++) {
            if ((a * i) % 26 == 1) {
                inv = i;
                found = 1;
                break;
            }
        }

        if (!found) continue;

        /* 4a + b = 1 (mod 26) */
        b = (1 - 4 * a) % 26;
        if (b < 0) b += 26;

        /* Check T -> U */
        if ((19 * a + b) % 26 != 20)
            continue;

        printf("a = %d, b = %d\nPlaintext: ", a, b);

        for (i = 0; cipher[i] != '\0'; i++) {
            if (isalpha(cipher[i])) {
                c = toupper(cipher[i]) - 'A';
                p = (inv * (c - b + 26)) % 26;
                printf("%c", p + 'A');
            } else {
                printf("%c", cipher[i]);
            }
        }
        return 0;
    }

    printf("No valid key found.\n");
    return 0;
}
